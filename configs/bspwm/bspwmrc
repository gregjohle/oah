#!/usr/bin/env bash

# ============================================================================
# BSPWM Configuration
# ============================================================================

# (Re)start the key daemon for this display only. bspwmrc reruns on every
# `bspc wm -r`, so replace the sxhkd this file started earlier, tracked by a
# pidfile per display, and never touch sxhkd instances on other displays.
sxhkd_pidfile="${XDG_RUNTIME_DIR:-/tmp}/oah-sxhkd-${DISPLAY//[^0-9.]/}.pid"
if [[ -f $sxhkd_pidfile ]]; then
  old_pid=$(cat "$sxhkd_pidfile")
  if [[ $old_pid =~ ^[0-9]+$ && $(ps -o comm= -p "$old_pid" 2>/dev/null) == sxhkd ]]; then
    kill "$old_pid" 2>/dev/null
    while kill -0 "$old_pid" 2>/dev/null; do sleep 0.05; done
  fi
fi
# Per-user bindings (generated at login by `oah-gen-keybindings --user`)
# when present, else the committed defaults.
sxhkdrc="${XDG_CONFIG_HOME:-$HOME/.config}/oah/sxhkd/sxhkdrc"
[[ -f $sxhkdrc ]] || sxhkdrc="$(dirname "$(readlink -f "$0")")/../sxhkd/sxhkdrc"
sxhkd -c "$sxhkdrc" &
echo $! >"$sxhkd_pidfile"

# ============================================================================
# Monitors & Workspaces
# ============================================================================
# Automatically detect the primary monitor and assign workspaces
PRIMARY_MONITOR=$(xrandr --query | grep ' connected primary' | cut -d' ' -f1)
if [ -z "$PRIMARY_MONITOR" ]; then
    PRIMARY_MONITOR=$(bspc query -M --names | head -n 1)
fi

bspc monitor "$PRIMARY_MONITOR" -d 1 2 3 4 5 6 7 8 9

# ============================================================================
# Window Rules & Behavior
# ============================================================================
# Tiling settings
bspc config split_ratio          0.50
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Visuals (Gaps and Borders)
# Matched to Omarchy's Hyprland defaults (gaps_in: 5, gaps_out: 10)
bspc config window_gap            10
bspc config border_width          2

# Border Colors
# Upstream's defaults (default/hypr/looknfeel.lua: active #33ccff -> #00ff99
# gradient, inactive #595959) as a fallback; the current theme's colours are
# applied on top by `hyprctl reload` (OAH's stand-in), the same call
# omarchy-theme-set makes on every theme change.
bspc config normal_border_color   "#595959"
bspc config active_border_color   "#595959"
bspc config focused_border_color  "#33ccff"
bspc config presel_feedback_color "#00ff99"
command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1

# Mouse: upstream binds SUPER + left drag to move and SUPER + right drag to
# resize (default/hypr/bindings/tiling.lua); bspwm does both natively.
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action3 resize_corner
# Upstream binds no middle drag; bspwm's default would resize.
bspc config pointer_action2 none

# ============================================================================
# Application Specific Rules
# ============================================================================
# Ensure floating dialogs and specific apps spawn floating
bspc rule -a "Pavucontrol" state=floating rectangle=800x600+0+0 center=true
bspc rule -a "Lxappearance" state=floating center=true
bspc rule -a "polkit-gnome-authentication-agent-1" state=floating center=true
# Upstream default/hypr/apps/system.lua: the screensaver is always fullscreen
# (omarchy-launch-screensaver adds one-shot rules on top to pick the monitor).
bspc rule -a org.omarchy.screensaver state=fullscreen

# Wait for bspwm to initialize properly
sleep 1
