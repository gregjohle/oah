#!/usr/bin/env python3
"""Keep the Omarchy shell's X11 panels in their layers, and give the keyboard
to the ones that take it.

On Wayland, Hyprland's layer-shell puts the wallpaper on the Background layer
and the bar, menus, OSD and notifications on the Top/Overlay layers, whatever
order they map in. On X11 the shell's panels are unmanaged dock windows that
only *ask* to be kept below/above (_NET_WM_STATE_BELOW/_ABOVE); bspwm, like
most X11 window managers, doesn't restack windows it doesn't manage. So a
wallpaper that maps after the bar covers it, and a new app window covers
the bar's popups.

This daemon watches the root window and restores the order whenever it's
wrong: shell dock windows asking to be below go to the bottom, those asking
to be above go to the top, keeping their relative order. It never touches
windows bspwm manages, and only restacks when the order is actually wrong, so
its own restacking can't loop.

Keyboard focus: on Wayland, a layer-shell surface with keyboard focus
Exclusive or OnDemand (the clipboard and emoji pickers, menus, keyboard-driven
panels, polkit) gets the keyboard as soon as it maps. On X11 the shell maps
them as unmanaged windows that set WM_HINTS input = True ("focusable"), and
nothing gives them focus, so keys keep going to the app behind. This daemon
focuses such a window when it becomes viewable (or turns focusable), and when
it goes away while holding focus, gives focus back to bspwm's active window.

Usage: oah-x11-stacking [--once]
  --once  fix the stacking once and exit (for tests)
"""

import sys

from Xlib import X, Xatom, Xutil, display, error


def main() -> int:
    once = "--once" in sys.argv[1:]
    d = display.Display()
    root = d.screen().root

    atom = lambda name: d.intern_atom(name)
    WM_STATE = atom("_NET_WM_STATE")
    BELOW = atom("_NET_WM_STATE_BELOW")
    ABOVE = atom("_NET_WM_STATE_ABOVE")
    WM_TYPE = atom("_NET_WM_WINDOW_TYPE")
    DOCK = atom("_NET_WM_WINDOW_TYPE_DOCK")
    ACTIVE = atom("_NET_ACTIVE_WINDOW")

    def atoms(w, prop):
        try:
            p = w.get_full_property(prop, Xatom.ATOM)
        except error.XError:
            return ()
        return tuple(p.value) if p else ()

    def mapped(w):
        try:
            return w.get_attributes().map_state == X.IsViewable
        except error.XError:
            return False

    def enforce():
        try:
            children = root.query_tree().children  # bottom -> top
        except error.XError:
            return
        windows = [w for w in children if mapped(w)]
        docks = {w.id for w in windows if DOCK in atoms(w, WM_TYPE)}
        below = [w for w in windows if w.id in docks and BELOW in atoms(w, WM_STATE)]
        above = [w for w in windows if w.id in docks and ABOVE in atoms(w, WM_STATE)]
        below_ids, above_ids = {w.id for w in below}, {w.id for w in above}

        order = [w.id for w in windows]
        others = [i for i in order if i not in below_ids and i not in above_ids]
        desired = [w.id for w in below] + others + [w.id for w in above]
        if order == desired:
            return

        try:
            # Lowering in reverse keeps the below-windows' relative order;
            # raising in order keeps the above-windows'.
            for w in reversed(below):
                w.configure(stack_mode=X.Below)
            for w in above:
                w.configure(stack_mode=X.Above)
            d.sync()
        except error.XError:
            pass  # a window vanished mid-restack; the next event retries

    # --- keyboard focus for focusable shell windows ---------------------------

    watched = set()  # shell windows whose property changes we listen to

    def shell_dock(w):
        return DOCK in atoms(w, WM_TYPE)

    def takes_keyboard(w):
        try:
            hints = w.get_wm_hints()
        except error.XError:
            return False
        return bool(hints and hints.flags & Xutil.InputHint and hints.input)

    def watch(w):
        if w.id not in watched:
            try:
                w.change_attributes(event_mask=X.PropertyChangeMask)
                watched.add(w.id)
            except error.XError:
                pass

    def give_focus(w):
        try:
            w.set_input_focus(X.RevertToPointerRoot, X.CurrentTime)
            d.sync()
        except error.XError:
            pass

    def return_focus(w):
        """w stopped taking the keyboard; if it still has focus (or focus fell
        to nothing), hand it back to bspwm's active window."""
        try:
            focus = d.get_input_focus().focus
        except error.XError:
            return
        current = focus.id if hasattr(focus, "id") else focus
        if current not in (w.id, X.NONE, X.PointerRoot, root.id):
            return
        try:
            p = root.get_full_property(ACTIVE, Xatom.WINDOW)
        except error.XError:
            p = None
        target = d.create_resource_object("window", p.value[0]) if p and p.value[0] else None
        if target is not None and mapped(target):
            give_focus(target)
        else:
            try:
                d.set_input_focus(X.PointerRoot, X.RevertToPointerRoot, X.CurrentTime)
                d.sync()
            except error.XError:
                pass

    def on_focus_event(e):
        w = getattr(e, "window", None)
        if w is None:
            return
        if e.type == X.MapNotify:
            if shell_dock(w):
                watch(w)
                if takes_keyboard(w):
                    give_focus(w)
        elif e.type == X.UnmapNotify:
            if w.id in watched:
                return_focus(w)
        elif e.type == X.DestroyNotify:
            watched.discard(w.id)
        elif e.type == X.PropertyNotify and e.atom == Xatom.WM_HINTS and w.id in watched:
            if not mapped(w):
                return
            if takes_keyboard(w):
                give_focus(w)
            else:
                return_focus(w)

    root.change_attributes(event_mask=X.SubstructureNotifyMask)
    enforce()
    if once:
        return 0
    try:
        for w in root.query_tree().children:
            if mapped(w) and shell_dock(w):
                watch(w)
    except error.XError:
        pass

    relevant = (X.MapNotify, X.ConfigureNotify, X.CirculateNotify, X.ReparentNotify)
    while True:
        # Coalesce a burst of events into one stacking check, but look at
        # every event in it: a MapNotify behind a CreateNotify must still
        # trigger it. Focus is handled per event, in order.
        e = d.next_event()
        on_focus_event(e)
        wanted = e.type in relevant
        while d.pending_events():
            e = d.next_event()
            on_focus_event(e)
            wanted = e.type in relevant or wanted
        if wanted:
            enforce()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
