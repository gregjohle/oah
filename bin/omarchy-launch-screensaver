#!/bin/bash

# omarchy:summary=Launch the Omarchy screensaver in the default terminal on the system with the correct font configuration.

# OAH(x11): upstream opens one fullscreen screensaver terminal per monitor
# through Hyprland (focus the monitor, exec with a [workspace] rule, wait on
# Hyprland's event socket for openwindow). On bspwm, a one-shot rule puts the
# next screensaver window on the monitor, fullscreen and focused
# (default/hypr/apps/system.lua: fullscreen), and the script waits for that
# window to appear. The rest is upstream's.

# Exit early if screensaver is already running
pgrep -f '[o]rg.omarchy.screensaver' && exit 0

# Allow screensaver to be turned off but also force started
if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

focused=$(bspc query -M -m focused --names) # OAH(x11): was omarchy-hyprland-monitor-focused
terminal=$(xdg-terminal-exec --print-id)

case $terminal in
*Alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  omarchy-notification-send -g ✋ "$(omarchy-i18n screensaver.terminalOnly)"
  exit 1
  ;;
esac

# OAH(x11): screensaver windows that bspwm manages right now.
screensaver_windows() {
  local node
  for node in $(bspc query -N -n .window 2>/dev/null); do
    xprop -id "$node" WM_CLASS 2>/dev/null | grep -q '"org\.omarchy\.screensaver"' && echo "$node"
  done
}

# OAH(x11): was hypr_exec; detached so the terminal outlives this script.
launch() {
  setsid -f "$@" >/dev/null 2>&1
}

# Block until this monitor's screensaver actually opens before moving on, so
# slow-starting terminals don't land on the wrong monitor. The deadline is a
# safety net in case the window never appears.
wait_for_screensaver_window() {
  local before=$1 deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)); do
    (($(screensaver_windows | wc -l) > before)) && return 0
    sleep 0.05
  done
}

for m in $(bspc query -M --names); do
  count=$(screensaver_windows | wc -l)
  # OAH(x11): was hypr_focus_monitor + the [workspace special:screensaver-$m] rule.
  bspc rule -a org.omarchy.screensaver -o monitor="$m" state=fullscreen focus=on

  case $terminal in
  *Alacritty*)
    launch alacritty --class=org.omarchy.screensaver --config-file "$OMARCHY_PATH/default/alacritty/screensaver.toml" -e omarchy-screensaver
    ;;
  *ghostty*)
    launch ghostty --class=org.omarchy.screensaver --config-file="$OMARCHY_PATH/default/ghostty/screensaver" --font-size=18 -e omarchy-screensaver
    ;;
  *foot*)
    launch foot --app-id=org.omarchy.screensaver --config="$OMARCHY_PATH/default/foot/screensaver.ini" -e omarchy-screensaver
    ;;
  *kitty*)
    launch kitty --class=org.omarchy.screensaver --override font_size=18 --override window_padding_width=0 -e omarchy-screensaver
    ;;
  esac

  wait_for_screensaver_window "$count"
done

# OAH(x11): a one-shot rule whose window never came would send the next
# screensaver to its monitor; drop those (listed with "->"), last first so the
# indexes hold. The permanent fullscreen rule from bspwmrc ("=>") stays, so a
# terminal slower than the wait above still opens fullscreen.
bspc rule -l | grep -n '^org\.omarchy\.screensaver:.* -> ' | cut -d: -f1 | sort -rn |
  while read -r index; do bspc rule -r "^$index"; done

bspc monitor -f "$focused" # OAH(x11): was hypr_focus_monitor

# Closing the last screensaver can leave focus on another monitor. Hand focus
# back to the monitor that had it once they are all gone.
(
  while [[ -n $(screensaver_windows) ]]; do
    sleep 0.5
  done
  bspc monitor -f "$focused"
) >/dev/null 2>&1 &
