#!/usr/bin/env python3
"""OAH(x11): report window title changes, for shell/Oah/Compositor.qml.

bspwm reports windows opening, closing and moving, but not a window
renaming itself (a browser switching tabs, a terminal running a command),
which Hyprland reports as `windowtitlev2`. This watches _NET_WM_NAME and
WM_NAME on every top-level window and prints the window id (decimal, as
bspwm's state uses) whenever one changes.

Usage: oah-x11-titles
"""

import sys

from Xlib import X, display, error


def main():
    d = display.Display()
    root = d.screen().root
    names = {d.intern_atom("_NET_WM_NAME"), d.intern_atom("WM_NAME")}

    def watch(w):
        try:
            w.change_attributes(event_mask=X.PropertyChangeMask)
        except error.XError:
            pass  # gone already

    root.change_attributes(event_mask=X.SubstructureNotifyMask)
    for w in root.query_tree().children:
        watch(w)
    d.flush()

    while True:
        e = d.next_event()
        if e.type == X.CreateNotify:
            watch(e.window)
            d.flush()
        elif e.type == X.PropertyNotify and e.atom in names:
            print(e.window.id, flush=True)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
