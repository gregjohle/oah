#!/usr/bin/env python3
"""Run keybinding rows from a bindings table generated by
tools/oah-gen-keybindings. sxhkd calls `oah-bind -t <table> <n>...` per chord.

  kind cmd   the action is a shell command
  kind dsp   the action is a Hyprland dispatcher call, run with `hyprctl dispatch`

Hyprland fires a binding once per key press unless it's marked `repeating`.
sxhkd fires on every autorepeat, and X gives it no way to tell a repeat from
a new press. So for `once` rows this records that the row fired and ignores it
until the chord's key has been physically released (read from the real
keyboard state), then a new press fires again.

Usage: oah-bind [-t TABLE] N...   (default table: configs/sxhkd/bindings.tsv)
"""

import hashlib
import os
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
RELEASE_SETTLE = 0.12  # seconds the key must stay up to count as released
LOCK_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", f"oah-bind-{os.getuid()}")


def rows(table):
    found = {}
    with open(table, encoding="utf-8") as f:
        for line in f:
            if line.startswith("#"):
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) >= 5:
                found[parts[0]] = parts + ["once"] * (6 - len(parts))
    return found


def key_keycode(chord):
    """The keycode of a chord's main key ("super + Tab" -> Tab's), or None."""
    key = chord.split("+")[-1].strip().lstrip("@~")
    if key.startswith("button"):
        return None
    try:
        from Xlib import XK, display
        d = display.Display()
        sym = XK.string_to_keysym(key)
        code = d.keysym_to_keycode(sym) if sym else 0
        d.close()
        return code or None
    except Exception:
        return None


def key_down(keycode):
    from Xlib import display
    d = display.Display()
    try:
        keymap = d.query_keymap()
        return bool(keymap[keycode // 8] & (1 << (keycode % 8)))
    finally:
        d.close()


def held_elsewhere(lock):
    """True while an earlier press of this row is still held down."""
    try:
        pid = int(open(lock).read().strip())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        return False


def watch_release(lock, keycode):
    """Hold the lock until the key is released (max 60 s), from a background
    child. The lock is written before the action fires, so even a fast
    autorepeat finds it."""
    pid = os.fork()
    if pid:
        with open(lock, "w") as f:
            f.write(str(pid))
        return
    os.setsid()
    try:
        # Autorepeat sends release/press pairs, so the key can read as up for
        # an instant while it's held; only a key that stays up for longer
        # than a few repeat intervals has really been released.
        deadline = time.monotonic() + 60
        up_since = None
        while time.monotonic() < deadline:
            if key_down(keycode):
                up_since = None
            elif up_since is None:
                up_since = time.monotonic()
            elif time.monotonic() - up_since >= RELEASE_SETTLE:
                break
            time.sleep(0.02)
    finally:
        try:
            os.unlink(lock)
        except OSError:
            pass
        os._exit(0)


def run(row):
    _, chord, _, kind, action, repeat = row[:6]
    if repeat != "repeat":
        keycode = key_keycode(chord)
        if keycode:
            os.makedirs(LOCK_DIR, exist_ok=True)
            # Stable across processes (Python's hash() of a str isn't).
            lock = os.path.join(LOCK_DIR, hashlib.sha1(f"{chord}\t{row[0]}".encode()).hexdigest()[:16])
            if held_elsewhere(lock):
                return  # an autorepeat of a press that already fired
            watch_release(lock, keycode)
    if kind == "cmd":
        subprocess.Popen(["bash", "-c", action], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif kind == "dsp":
        subprocess.run(["hyprctl", "dispatch", action], stdout=subprocess.DEVNULL)
    else:
        print(f"oah-bind: row {row[0]} has unknown kind '{kind}'", file=sys.stderr)


def main(argv):
    table = os.path.join(ROOT, "configs", "sxhkd", "bindings.tsv")
    if argv[:1] == ["-t"]:
        table, argv = argv[1], argv[2:]
    table_rows = rows(table)
    for n in argv:
        if n in table_rows:
            run(table_rows[n])
        else:
            print(f"oah-bind: no binding {n} in {table}", file=sys.stderr)


if __name__ == "__main__":
    main(sys.argv[1:])
