#!/bin/bash
# Run keybinding rows from configs/sxhkd/bindings.tsv (generated by
# tools/oah-gen-keybindings). sxhkd calls `oah-bind <n>...` for each chord.
#
#   kind cmd  the action is a shell command
#   kind dsp  the action is a Hyprland dispatcher call, run with `hyprctl dispatch`

set -uo pipefail

table="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../configs/sxhkd/bindings.tsv"

for n in "$@"; do
  row=$(awk -F'\t' -v n="$n" '$1 == n { print; exit }' "$table")
  if [[ -z $row ]]; then
    echo "oah-bind: no binding $n in $table" >&2
    continue
  fi
  IFS=$'\t' read -r _ _ _ kind action <<<"$row"
  case "$kind" in
    cmd) setsid -f bash -c "$action" >/dev/null 2>&1 ;;
    dsp) hyprctl dispatch "$action" >/dev/null ;;
    *) echo "oah-bind: binding $n has unknown kind '$kind'" >&2 ;;
  esac
done
