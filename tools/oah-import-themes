#!/bin/bash
# Copy Omarchy's themes from the pinned release into oah/themes, so OAH ships
# them itself. OAH doesn't change themes; on an upstream upgrade, run this
# again to replace them with the new release's.
#
# Usage: oah-import-themes

set -euo pipefail

source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/lib/common.sh"

case "${1:-}" in
  "") ;;
  -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) oah_die "unknown argument: $1" ;;
esac

work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
oah_fetch_upstream "$work/omarchy"

dest=$OAH_ROOT/themes
rm -rf -- "$dest.new"
cp -a -- "$work/omarchy/themes" "$dest.new"
# Omarchy is MIT-licensed; its notice travels with the copy.
cp -- "$work/omarchy/LICENSE" "$dest.new/LICENSE.omarchy"
printf '%s\n' "$OAH_PIN" >"$dest.new/.oah-upstream"
rm -rf -- "$dest"
mv -T -- "$dest.new" "$dest"

echo "Imported $(find "$dest" -mindepth 1 -maxdepth 1 -type d | wc -l) themes from Omarchy $OAH_PIN into $dest"
