#!/bin/bash
# Seed $HOME the way an Omarchy install seeds a new user, without overwriting
# anything that's already there:
#   - upstream's shipped user configs (config/ -> ~/.config), like /etc/skel
#   - the package fontconfig defaults (50-omarchy.conf)
#   - the default monospace font (omarchy-font-set)
#   - the default theme (omarchy-theme-set, headless)
#
# Used by the session on first login, by oah-dev for its dev home, and by the
# installer. Each step is skipped when its result already exists, so running
# it again is safe.
#
# Requires OMARCHY_PATH (the runtime tree) and its bin/ on PATH.
#
# Usage: oah-seed-home [--theme NAME]   (default theme: "Tokyo Night")

set -euo pipefail

theme="Tokyo Night"
case "${1:-}" in
  --theme) theme=${2:?--theme needs a name} ;;
  "") ;;
  *) echo "Usage: oah-seed-home [--theme NAME]" >&2; exit 2 ;;
esac

: "${OMARCHY_PATH:?OMARCHY_PATH must point at the OAH runtime tree}"
config=${XDG_CONFIG_HOME:-$HOME/.config}
state=${XDG_STATE_HOME:-$HOME/.local/state}

mkdir -p "$config/omarchy/themes" "$config/fontconfig/conf.d"

# Shipped configs: copy what's missing, never replace a user's file.
cp -an "$OMARCHY_PATH/config/." "$config/"

if [[ ! -e $config/fontconfig/conf.d/50-omarchy.conf ]]; then
  cp "$OMARCHY_PATH/default/fontconfig/conf.avail/50-omarchy.conf" "$config/fontconfig/conf.d/"
fi

# omarchy-font-set and omarchy-theme-set notify and restart a running
# session, and font-set signals running terminals (pkill -USR1 kitty, ...).
# None of that belongs to seeding: those processes may be another session's.
stubs=$(mktemp -d)
trap 'rm -rf -- "$stubs"' EXIT
for stub in omarchy-restart-shell omarchy-hook omarchy-notification-send pkill killall; do
  printf '#!/bin/sh\nexit 0\n' >"$stubs/$stub"
  chmod +x "$stubs/$stub"
done

if [[ ! -f $config/fontconfig/fonts.conf ]]; then
  PATH="$stubs:$PATH" omarchy-font-set "JetBrainsMono Nerd Font" >/dev/null
fi

if [[ ! -s $state/omarchy/current/theme.name ]]; then
  PATH="$stubs:$PATH" OMARCHY_THEME_HEADLESS=1 omarchy-theme-set "$theme" >/dev/null
  [[ -s $state/omarchy/current/theme.name ]] || { echo "oah-seed-home: seeding the theme failed" >&2; exit 1; }
fi
