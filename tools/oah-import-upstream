#!/bin/bash
# Copy what OAH runs from the pinned Omarchy release into this repo, in
# Omarchy's own layout (bin/, default/, config/, themes/, ...), so an installed
# OAH needs no Omarchy checkout. Run it again after bumping UPSTREAM to take
# the next release.
#
#   - agents applications config default etc install migrations themes and the
#     root files below are replaced as released, except files OAH has changed
#     (they carry an "OAH(x11)" marker), which are kept and listed for a
#     manual merge, as in bin/.
#   - bin/: every upstream command is copied, except files OAH has changed
#     (they carry an "OAH(x11)" marker); those are listed for a manual merge.
#     bin/.oah-upstream-commands lists the release's commands, so a command a
#     later release drops is removed (or listed, if OAH changed it).
#   - shell/ has OAH edits throughout; it comes from tools/oah-import-shell.
#   - manual/, test/, docs/, plans/ and the repo's own dotfiles aren't used at
#     runtime and aren't copied.
#
# Usage: oah-import-upstream

set -euo pipefail

source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/lib/common.sh"

case "${1:-}" in
  "") ;;
  -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) oah_die "unknown argument: $1" ;;
esac

dirs=(agents applications config default etc install migrations themes)
files=(version logo.txt logo.svg icon.txt icon.png)

work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
oah_fetch_upstream "$work/omarchy"
src=$work/omarchy

kept_files=()
for d in "${dirs[@]}"; do
  [[ -d $src/$d ]] || oah_die "$OAH_PIN has no $d/"
  rm -rf -- "$OAH_ROOT/$d.new"
  cp -a -- "$src/$d" "$OAH_ROOT/$d.new"
  # OAH's changed files survive the replacement.
  if [[ -d $OAH_ROOT/$d ]]; then
    while IFS= read -r -d '' changed; do
      rel=${changed#"$OAH_ROOT/"}
      mkdir -p -- "$(dirname -- "$OAH_ROOT/$d.new/${rel#"$d/"}")"
      cp -a -- "$changed" "$OAH_ROOT/$d.new/${rel#"$d/"}"
      kept_files+=("$rel")
    done < <(grep -rlZ --binary-files=without-match 'OAH(x11)' -- "$OAH_ROOT/$d" || true)
  fi
  rm -rf -- "${OAH_ROOT:?}/$d"
  mv -T -- "$OAH_ROOT/$d.new" "$OAH_ROOT/$d"
done
for f in "${files[@]}"; do
  cp -a -- "$src/$f" "$OAH_ROOT/$f"
done
# Omarchy is MIT-licensed; its notice travels with the copy.
cp -- "$src/LICENSE" "$OAH_ROOT/LICENSE.omarchy"

mkdir -p "$OAH_ROOT/bin"
manifest=$OAH_ROOT/bin/.oah-upstream-commands
copied=0 kept=() removed=() dropped_kept=()
if [[ -f $manifest ]]; then
  while IFS= read -r name; do
    [[ -n $name && ! -e $src/bin/$name && -e $OAH_ROOT/bin/$name ]] || continue
    if grep -q 'OAH(x11)' "$OAH_ROOT/bin/$name"; then
      dropped_kept+=("$name")
    else
      rm -f -- "$OAH_ROOT/bin/$name"
      removed+=("$name")
    fi
  done <"$manifest"
fi
for cmd in "$src"/bin/*; do
  name=${cmd##*/}
  if [[ -e $OAH_ROOT/bin/$name ]] && grep -q 'OAH(x11)' "$OAH_ROOT/bin/$name"; then
    kept+=("$name")
    continue
  fi
  cp -a -- "$cmd" "$OAH_ROOT/bin/$name"
  copied=$((copied + 1))
done

(cd "$src/bin" && printf '%s\n' *) >"$manifest"

echo "Imported Omarchy $OAH_PIN: ${dirs[*]}, ${files[*]}, $copied bin commands"
if (( ${#removed[@]} )); then
  echo "Removed commands $OAH_PIN no longer has:"
  printf '  bin/%s\n' "${removed[@]}"
fi
if (( ${#dropped_kept[@]} )); then
  echo "$OAH_PIN dropped these commands, but OAH changed them (decide by hand):"
  printf '  bin/%s\n' "${dropped_kept[@]}"
fi
if (( ${#kept[@]} )); then
  echo "Kept OAH's changed commands (merge $OAH_PIN's changes into them by hand):"
  printf '  bin/%s\n' "${kept[@]}"
fi
if (( ${#kept_files[@]} )); then
  echo "Kept OAH's changed files (merge $OAH_PIN's changes into them by hand):"
  printf '  %s\n' "${kept_files[@]}"
fi
